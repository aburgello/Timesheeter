# Whitespace basics every editor understands. Deliberately not a formatter:
# see eslint.config.js for why the existing code isn't being reformatted.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
